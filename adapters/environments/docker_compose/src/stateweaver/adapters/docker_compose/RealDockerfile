FROM python:3.13-alpine3.22@sha256:e81548ac35b07a3bd4805f275107592ef458b1e893c0e04d45aedaa19416cca5

WORKDIR /opt/stateweaver
COPY real_provider_bridge.py /opt/stateweaver/real_provider_bridge.py

RUN mkdir -p /state/filesystem /state/session /state/clock \
    && chown -R 65532:65532 /opt/stateweaver /state

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["python", "/opt/stateweaver/real_provider_bridge.py"]
CMD ["serve"]
