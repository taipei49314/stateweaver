{
  "name": "stateweaver-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm --prefix ../../tests/e2e/public_release run verify",
    "test:e2e:ci": "npm ci --prefix ../../tests/e2e/public_release && npm run test:e2e:install && npm run test:e2e",
    "test:e2e:install": "npm --prefix ../../tests/e2e/public_release run install:chromium",
    "verify:public-release": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e:ci",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.9.0",
    "happy-dom": "20.11.2",
    "prettier": "3.9.6",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
